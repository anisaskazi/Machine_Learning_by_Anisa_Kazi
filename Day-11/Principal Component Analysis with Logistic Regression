# Day 11 of Machine Learning
# Principal Component Analysis with Logistic Regression
# Dataset: Wine Dataset

import matplotlib.pyplot as plt
import pandas as pd
from sklearn.datasets import load_wine
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    ConfusionMatrixDisplay,
    accuracy_score,
    classification_report,
    confusion_matrix
)
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler


def main():
    print("=" * 65)
    print("DAY 11: PCA WITH LOGISTIC REGRESSION")
    print("=" * 65)

    # 1. Load the Wine dataset
    wine = load_wine()

    X = pd.DataFrame(
        wine.data,
        columns=wine.feature_names
    )

    y = pd.Series(
        wine.target,
        name="Target"
    )

    # 2. Display dataset details
    print("\nFirst 5 rows of the dataset:")
    print(X.head())

    print("\nDataset shape:", X.shape)
    print("Number of features:", X.shape[1])
    print("Target classes:", list(wine.target_names))

    print("\nMissing values:")
    print(X.isnull().sum())

    print("\nClass distribution:")
    print(y.value_counts().sort_index())

    # 3. Split the dataset
    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.20,
        random_state=42,
        stratify=y
    )

    print("\nTraining samples:", X_train.shape[0])
    print("Testing samples:", X_test.shape[0])

    # 4. Scale the features
    scaler = StandardScaler()

    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled = scaler.transform(X_test)

    # 5. Apply PCA
    pca = PCA(n_components=2)

    X_train_pca = pca.fit_transform(X_train_scaled)
    X_test_pca = pca.transform(X_test_scaled)

    print("\nOriginal number of features:", X.shape[1])
    print("Reduced number of features:", X_train_pca.shape[1])

    print("\nExplained Variance Ratio:")
    print(pca.explained_variance_ratio_)

    total_variance = pca.explained_variance_ratio_.sum()

    print(
        f"\nTotal Variance Preserved: "
        f"{total_variance * 100:.2f}%"
    )

    # 6. Create the Logistic Regression model
    model = LogisticRegression(
        max_iter=1000,
        random_state=42
    )

    # 7. Train the model
    model.fit(X_train_pca, y_train)

    # 8. Make predictions
    y_pred = model.predict(X_test_pca)

    # 9. Evaluate the model
    accuracy = accuracy_score(y_test, y_pred)
    matrix = confusion_matrix(y_test, y_pred)

    print("\nModel Accuracy:")
    print(f"{accuracy * 100:.2f}%")

    print("\nConfusion Matrix:")
    print(matrix)

    print("\nClassification Report:")
    print(
        classification_report(
            y_test,
            y_pred,
            target_names=wine.target_names,
            zero_division=0
        )
    )

    # 10. Create PCA DataFrame
    pca_data = pd.DataFrame({
        "Principal Component 1": X_train_pca[:, 0],
        "Principal Component 2": X_train_pca[:, 1],
        "Target": y_train.values
    })

    pca_data["Class Name"] = pca_data["Target"].map({
        0: wine.target_names[0],
        1: wine.target_names[1],
        2: wine.target_names[2]
    })

    print("\nPCA Transformed Data:")
    print(pca_data.head())

    # 11. Visualize PCA components
    plt.figure(figsize=(10, 7))

    for class_value, class_name in enumerate(wine.target_names):
        class_data = pca_data[
            pca_data["Target"] == class_value
        ]

        plt.scatter(
            class_data["Principal Component 1"],
            class_data["Principal Component 2"],
            label=class_name,
            alpha=0.75,
            s=80
        )

    plt.xlabel("Principal Component 1")
    plt.ylabel("Principal Component 2")
    plt.title("Wine Dataset after PCA")
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.savefig(
        "pca_visualization.png",
        dpi=300
    )
    plt.show()

    # 12. Plot explained variance
    explained_variance = pca.explained_variance_ratio_ * 100

    plt.figure(figsize=(8, 5))
    plt.bar(
        ["Principal Component 1", "Principal Component 2"],
        explained_variance
    )

    plt.xlabel("Principal Components")
    plt.ylabel("Explained Variance Percentage")
    plt.title("Explained Variance by PCA Components")
    plt.tight_layout()
    plt.savefig(
        "explained_variance.png",
        dpi=300
    )
    plt.show()

    # 13. Plot confusion matrix
    display = ConfusionMatrixDisplay(
        confusion_matrix=matrix,
        display_labels=wine.target_names
    )

    display.plot()

    plt.title("PCA Logistic Regression Confusion Matrix")
    plt.tight_layout()
    plt.savefig(
        "pca_confusion_matrix.png",
        dpi=300
    )
    plt.show()

    # 14. Predict a new sample
    new_sample = X.iloc[[0]]

    new_sample_scaled = scaler.transform(new_sample)
    new_sample_pca = pca.transform(new_sample_scaled)

    predicted_class = model.predict(new_sample_pca)[0]
    prediction_probabilities = model.predict_proba(
        new_sample_pca
    )[0]

    print("\nNew Sample Prediction:")
    print(
        "Predicted Wine Class:",
        wine.target_names[predicted_class]
    )

    print("\nPrediction Probabilities:")

    for class_name, probability in zip(
        wine.target_names,
        prediction_probabilities
    ):
        print(f"{class_name}: {probability * 100:.2f}%")

    # 15. Save test prediction results
    prediction_results = pd.DataFrame({
        "Actual Class": y_test.values,
        "Predicted Class": y_pred
    })

    prediction_results["Actual Class Name"] = (
        prediction_results["Actual Class"].map({
            0: wine.target_names[0],
            1: wine.target_names[1],
            2: wine.target_names[2]
        })
    )

    prediction_results["Predicted Class Name"] = (
        prediction_results["Predicted Class"].map({
            0: wine.target_names[0],
            1: wine.target_names[1],
            2: wine.target_names[2]
        })
    )

    prediction_results["Correct Prediction"] = (
        prediction_results["Actual Class"]
        == prediction_results["Predicted Class"]
    )

    print("\nFirst 10 Prediction Results:")
    print(prediction_results.head(10))

    # 16. Save output files
    pca_data.to_csv(
        "pca_transformed_data.csv",
        index=False
    )

    prediction_results.to_csv(
        "pca_prediction_results.csv",
        index=False
    )

    print("\nFiles created successfully:")
    print("1. pca_transformed_data.csv")
    print("2. pca_prediction_results.csv")
    print("3. pca_visualization.png")
    print("4. explained_variance.png")
    print("5. pca_confusion_matrix.png")


if __name__ == "__main__":
    main()
